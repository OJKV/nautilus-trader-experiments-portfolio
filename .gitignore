# --- agent / session state ---
.claude
.remember

# --- docs (ADR-0015) ---
# Design, strategy, failure-log and review docs ARE tracked: a cloud agent that
# cannot read them re-derives decisions and re-introduces solved bugs.
# Only what describes the live machine stays local.
docs/private/
docs/21-hetzner-setup-guide.md
docs/22-vps-options-2026.md
# Local agent review notes (per owner request 2026-10-11): never committed.
docs/muse/

# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key
wg*.conf

# --- data & artifacts (large, regenerable) ---
# Anchored with a leading slash: a bare `data/` also ignored src/ntx/data/, so
# the whole data pipeline would have been missing from the first commit (C-03).
/data/
/reports/
/logs/
*.parquet
*.zip
*.db
/data/catalog/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- os / editor ---
.DS_Store
.idea/
.vscode/

