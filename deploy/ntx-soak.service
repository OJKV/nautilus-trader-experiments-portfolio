[Unit]
Description=ntx S003 on OKX demo (soak)
After=network-online.target time-sync.target
Wants=network-online.target
# Never give up (owner, 2026-11-04, after F084): a start limit turned a 19-min
# glitch into a 38-h outage. RestartSec spaces the retries; exit 2 (a refusal) still
# stays down; a crash loop is paged by the alerter's stale-snapshot check.
StartLimitIntervalSec=0
# 10, not 5: RestartSec=120 caps a genuine crash loop at 15 starts in this
# window, so 10 still catches one -- while a normal run of deploys, each a
# stop+start, no longer locks the bot out of restarting itself.
StartLimitBurst=10
OnFailure=ntx-alert-crash@%n.service

[Service]
Type=simple
User=ntx
WorkingDirectory=/home/ntx/ntx
Environment=NTX_VENUE=okx_demo
# The FIRST demo sub-account, named explicitly. Left unset, a `.env` line
# `NTX_KEYSET=demo2` would move this soak onto S004's sub-account: two bots on
# one account, each closing the other's positions (R51/F064, E3-02). A blank pin
# would not help -- env_ignore_empty treats it as unset.
Environment=NTX_KEYSET=demo1
# Demo sizing basis; verify the demo environment is funded before starting.
Environment=NTX_EQUITY_OVERRIDE_USD=1000
# Set explicitly so the experiment cannot leak into (or out of) the live unit.
# Keep false until the attached stop is re-gated (T-05/B-10).
Environment=NTX_ATTACH_STOP_AT_ENTRY=false
ExecStart=/home/ntx/ntx/.venv/bin/python -m ntx.live.node --strategy S003
Restart=always
RestartPreventExitStatus=2
RestartSec=120
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# R44 rehearsal, started 2026-10-06: let nautilus rebuild an opening order it
# cannot find, so a restart adopts a position rather than abandoning it (F071).
# Demo only until it is shown to adopt cleanly with no phantoms; promotion to
# live is one line in ntx-s003.service. See docs/27-open-rehearsals.md.
Environment=NTX_GENERATE_MISSING_ORDERS=1
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
